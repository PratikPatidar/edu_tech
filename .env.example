# MongoDB Atlas Database Connection URI
MONGODB_URI="mongodb+srv://<db_username>:<db_password>@cluster0.mongodb.net/edumiracle?retryWrites=true&w=majority"

# JWT Authentication secret (Use a secure, random 32+ character string)
JWT_SECRET="your_secure_random_jwt_secret_hash"

# Default Administrator Credentials (Seeded via /api/init)
ADMIN_EMAIL="admin@gmail.com"
ADMIN_PASSWORD="Admin@1234"

# Google Gemini API Key (Optional — for AI Doubts feature)
GEMINI_API_KEY="AIzaSy..."
